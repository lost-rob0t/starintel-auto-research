#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"

emacs --batch -Q --load "$root/pages/bootstrap.el"

if [[ -d "$root/pages/root" ]]; then
  cp -a "$root/pages/root/." "$root/_site/"
fi

python3 "$root/scripts/build-research-pending.py" "$root/_site"
python3 "$root/scripts/enhance-pages.py" "$root/_site"

python3 - "$root/_site" <<'PY'
import json
import sys
import xml.etree.ElementTree as ET
from pathlib import Path

site = Path(sys.argv[1])
feed = site / "feed.xml"
search = site / "search-index.json"
index = site / "index.html"
review = site / "research-pending" / "index.html"

if not feed.is_file() or feed.stat().st_size == 0:
    raise SystemExit("RSS feed was not generated")
if not review.is_file() or review.stat().st_size == 0:
    raise SystemExit("research-pending dashboard was not generated")
records = json.loads(search.read_text(encoding="utf-8"))
if len(records) > 1 and len({record["modified"] for record in records}) < 2:
    raise SystemExit("all document modified dates collapsed to one build timestamp")
root = ET.parse(feed).getroot()
items = root.findall("./channel/item")
if not items:
    raise SystemExit("RSS feed contains no items")
if len(items) > 1 and len({item.findtext("pubDate") for item in items}) < 2:
    raise SystemExit("RSS item dates collapsed to one timestamp")
if "application/rss+xml" not in index.read_text(encoding="utf-8"):
    raise SystemExit("RSS autodiscovery link is missing from index.html")
print(
    f"pages_metadata=PASS records={len(records)} "
    f"modified_dates={len({record['modified'] for record in records})} "
    f"rss_items={len(items)} research_pending=present"
)
PY

# Keep the workflow artifact bound to the canonical public host.
printf '%s\n' 'auto-research.starintel.actor' > "$root/_site/CNAME"

# Make the deployed revision observable so stale Pages builds are immediately
# distinguishable from the current main branch.
python3 - "$root/_site/deployment.json" <<'PY'
import json
import os
import sys
from datetime import datetime, timezone
from pathlib import Path

output = Path(sys.argv[1])
payload = {
    "commit": os.environ.get("GITHUB_SHA", "local"),
    "run_id": os.environ.get("GITHUB_RUN_ID"),
    "built_at": datetime.now(timezone.utc).isoformat(),
    "domain": "auto-research.starintel.actor",
}
output.write_text(json.dumps(payload, indent=2) + "\n", encoding="utf-8")
PY
