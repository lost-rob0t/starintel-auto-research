{
  "fixture_id": "franklin-gate-and-delivery-v1.0.0",
  "jurisdiction": {
    "unit_id": "gov:us:oh:franklin-county",
    "unit_revision_id": "gov:us:oh:franklin-county@r1",
    "geoid": "39049"
  },
  "source_contract": "star.govdata.source-profile@1.0.0",
  "applicability_contract_revision_id": "star.govdata.ohio.route-applicability@r1",
  "cases": [
    {
      "id": "unit-create",
      "operation": "commit-unit-revision",
      "expected": "accepted",
      "input": {"unit_revision_id": "gov:us:oh:franklin-county@r1", "expected_prior_revision_id": null}
    },
    {
      "id": "unit-cas-conflict",
      "operation": "commit-unit-revision",
      "expected": "rejected-authority-conflict",
      "input": {"unit_revision_id": "gov:us:oh:franklin-county@r2", "expected_prior_revision_id": "gov:us:oh:franklin-county@r0", "actual_prior_revision_id": "gov:us:oh:franklin-county@r1"}
    },
    {
      "id": "component-supersession",
      "operation": "commit-component-revision",
      "expected": "accepted-new-revision",
      "input": {"component_id": "gov:us:oh:franklin-county:auditor", "component_revision_id": "gov:us:oh:franklin-county:auditor@r2", "prior_component_revision_id": "gov:us:oh:franklin-county:auditor@r1"}
    },
    {
      "id": "subject-owner-self-review",
      "operation": "commit-review-revision",
      "expected": "rejected-independence-policy",
      "input": {"subject_revision_id": "gov:us:oh:franklin-county:auditor@r2", "subject_owner_id": "identity-authority-1", "reviewer_id": "identity-authority-1"}
    },
    {
      "id": "review-cas-conflict",
      "operation": "commit-review-revision",
      "expected": "rejected-review-head-conflict",
      "input": {"subject_revision_id": "profile:franklin-auditor@r1", "expected_prior_review_revision_id": "review:profile:franklin-auditor@r0", "actual_prior_review_revision_id": "review:profile:franklin-auditor@r1"}
    },
    {
      "id": "artifact-and-intent-atomic-commit",
      "operation": "commit-artifact-and-delivery-intent",
      "expected": "accepted",
      "input": {"artifact_id": "artifact:sha256:aaa", "intent_id": "intent:artifact:aaa:attempt-1", "required_delivery_step_keys": ["retrieval-event:re-1", "normalization-release:nw-1"]}
    },
    {
      "id": "crash-before-retrieval-event",
      "operation": "recover-delivery-intent",
      "expected": "replay-both-pending-steps",
      "input": {"intent_id": "intent:artifact:bbb:attempt-2", "acknowledged_delivery_step_keys": [], "pending_delivery_step_keys": ["retrieval-event:re-2", "normalization-release:nw-2"]}
    },
    {
      "id": "crash-before-normalization-release",
      "operation": "recover-delivery-intent",
      "expected": "replay-normalization-only",
      "input": {"intent_id": "intent:artifact:ccc:attempt-3", "acknowledged_delivery_step_keys": ["retrieval-event:re-3"], "pending_delivery_step_keys": ["normalization-release:nw-3"]}
    },
    {
      "id": "duplicate-delivery-ack",
      "operation": "acknowledge-delivery-step",
      "expected": "idempotent-no-change",
      "input": {"intent_id": "intent:artifact:ddd:attempt-4", "delivery_step_key": "retrieval-event:re-4", "already_acknowledged": true}
    },
    {
      "id": "stale-fence-delivery",
      "operation": "acknowledge-delivery-step",
      "expected": "rejected-stale-fencing-token",
      "input": {"intent_id": "intent:artifact:eee:attempt-5", "attempt_fencing_token": 41, "current_fencing_token": 42}
    },
    {
      "id": "orphan-artifact-recovery",
      "operation": "scan-orphan-artifacts",
      "expected": "create-or-quarantine-intent",
      "input": {"artifact_id": "artifact:sha256:fff", "intent_id": null}
    },
    {
      "id": "checkpoint-pending-delivery",
      "operation": "commit-checkpoint",
      "expected": "accepted-explicitly-pending",
      "input": {"evidence_delivery_intent_ids": ["intent:artifact:ggg:attempt-6"], "acknowledged_delivery_step_keys": ["retrieval-event:re-6"], "pending_delivery_step_keys": ["normalization-release:nw-6"]}
    },
    {
      "id": "success-with-pending-delivery",
      "operation": "commit-terminal-result",
      "expected": "rejected-evidence-delivery-incomplete",
      "input": {"status": "success", "pending_delivery_step_keys": ["normalization-release:nw-7"]}
    },
    {
      "id": "canonical-basis-equivalence",
      "operation": "compute-gate-basis-hash",
      "expected": "equal-hash",
      "input": {"basis_a": ["route:1@r1", "route:2@r1", "route:16@r1"], "basis_b": ["route:16@r1", "route:2@r1", "route:1@r1"], "canonical_sort": true}
    },
    {
      "id": "canonical-basis-mismatch",
      "operation": "validate-gate-basis-hash",
      "expected": "rejected-hash-mismatch",
      "input": {"declared": "sha256:0000", "computed": "sha256:1111"}
    },
    {
      "id": "gate-expiry-without-write",
      "operation": "evaluate-current-completion",
      "expected": "false",
      "input": {"status": "passed", "valid_through": "2026-08-02T18:00:00Z", "evaluated_at": "2026-08-02T18:00:01Z"}
    },
    {
      "id": "review-invalidation-after-gate",
      "operation": "evaluate-current-completion",
      "expected": "false",
      "input": {"gate_revision_id": "gate:39049@r1", "bound_review_revision_id": "review:route-9@r1", "current_review_decision": "invalidated"}
    },
    {
      "id": "applicability-supersession-after-gate",
      "operation": "evaluate-current-completion",
      "expected": "false",
      "input": {"gate_revision_id": "gate:39049@r1", "bound_applicability_contract_revision_id": "star.govdata.ohio.route-applicability@r1", "current_applicability_contract_revision_id": "star.govdata.ohio.route-applicability@r2"}
    },
    {
      "id": "identity-supersession-after-gate",
      "operation": "evaluate-current-completion",
      "expected": "false",
      "input": {"gate_revision_id": "gate:39049@r1", "bound_component_revision_id": "gov:us:oh:franklin-county:clerk@r1", "current_component_revision_id": "gov:us:oh:franklin-county:clerk@r2"}
    },
    {
      "id": "operational-metadata-derived",
      "operation": "plan-route",
      "expected": "derived-gate-assertion-no-jobs",
      "input": {"route": "operational-metadata", "derived": true, "emits_jobs": false}
    }
  ]
}
